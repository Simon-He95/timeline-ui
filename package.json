{
  "name": "@simon_he/timeline-ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Fixed-layout, themeable timeline primitives for AI agent transcripts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simon-He95/timeline-ui.git"
  },
  "homepage": "https://github.com/Simon-He95/timeline-ui#readme",
  "bugs": {
    "url": "https://github.com/Simon-He95/timeline-ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs/logo-mark.svg",
    "docs/preview.png",
    "docs/docs-preview.png",
    "CHANGELOG.md"
  ],
  "main": "./dist/timeline-ui.js",
  "module": "./dist/timeline-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/timeline-ui.js"
    },
    "./style.css": "./dist/timeline-ui.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^26.1.0",
    "markstream-vue": "2.0.32",
    "stream-diffs": "0.0.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.12",
    "vue": "^3.5.35",
    "vue-tsc": "^2.2.12"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "keywords": [
    "vue",
    "vue3",
    "timeline",
    "agent",
    "ai",
    "chat",
    "transcript",
    "component"
  ],
  "license": "MIT",
  "author": "Simon He",
  "style": "./dist/timeline-ui.css",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
